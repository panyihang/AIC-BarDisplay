			"upgmode_pin_cfg_reg": "0x107004AC", //PINMUX REG, PE11
			"upgmode_pin_cfg_val": "0x13321",    // PINMUX VAL
			"upgmode_pin_input_reg": "0x10700400", // INPUT VAL REG, PE group
			"upgmode_pin_input_msk": "0x800", // Bit MSK, bit 11
